{
  "name": "@soe/svelte",
  "version": "0.1.0",
  "private": true,
  "description": "A simple Svelte object editor",
  "type": "module",
  "svelte": "./dist/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package --input src",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@soe/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3"
  }
}
