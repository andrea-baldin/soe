{
  "name": "@andreabaldin/soe-svelte",
  "version": "0.3.0",
  "description": "A simple Svelte object editor",
  "keywords": [
    "object-editor",
    "svelte",
    "svelte-5",
    "typescript"
  ],
  "homepage": "https://github.com/andrea-baldin/soe#readme",
  "bugs": "https://github.com/andrea-baldin/soe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrea-baldin/soe.git",
    "directory": "packages/svelte"
  },
  "license": "Apache-2.0",
  "author": "Andrea Baldin <andreabaldin@hotmail.com>",
  "type": "module",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "svelte-package --input src",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@andreabaldin/soe-core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3"
  }
}
